---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Style Guide — Elliot Buckland-Weir";
---

<BaseLayout
  {title}
  description="Design system reference for Elliot Buckland-Weir's security portfolio."
>
  <main class="style-page">
    <header class="hero">
      <p class="eyebrow">Design system</p>
      <h1>Style Guide</h1>
      <p>
        A reference page for the darker card-based layout used across the
        portfolio, tools, research, CV, and certification pages.
      </p>
    </header>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Typography</p>
        <h2>Text scale</h2>
      </div>

      <div class="type-card">
        <p class="hero-title">Hero title</p>
        <p class="section-title">Section title</p>
        <p class="card-title">Card title</p>
        <p class="body-copy">
          Body copy should be readable, quiet, and practical. This portfolio
          uses restrained text styling so tools and research content stay easy
          to scan.
        </p>
        <p class="small-note">Small notes, source labels, and metadata.</p>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Surfaces</p>
        <h2>Cards and panels</h2>
      </div>

      <div class="card-grid">
        <article>
          <span class="icon" aria-hidden="true">🌍</span>
          <p class="eyebrow">Threat Intelligence</p>
          <h3>IP Intelligence</h3>
          <p>
            Cards use a consistent border, dark translucent background, and
            compact spacing.
          </p>
        </article>

        <article>
          <span class="icon" aria-hidden="true">🛡️</span>
          <p class="eyebrow">Security Operations</p>
          <h3>Analyst Panel</h3>
          <p>
            Repeated cards should be easy to compare and should not rely on
            decorative gradients.
          </p>
        </article>

        <article>
          <span class="icon" aria-hidden="true">⚙️</span>
          <p class="eyebrow">Automation</p>
          <h3>Workflow Helper</h3>
          <p>
            Tool cards, research cards, and CV cards share the same visual
            language.
          </p>
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Buttons</p>
        <h2>Actions</h2>
      </div>

      <div class="button-card">
        <a href="#" class="primary-button">Primary action</a>
        <a href="#" class="secondary-button">Secondary action</a>
        <a href="#" class="text-link">Text link →</a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Template</p>
        <h2>Default page pattern</h2>
      </div>

      <pre><code>&lt;main class="page"&gt;
  &lt;header class="hero"&gt;
    &lt;p class="eyebrow"&gt;Section label&lt;/p&gt;
    &lt;h1&gt;Page title&lt;/h1&gt;
    &lt;p&gt;Short page summary.&lt;/p&gt;
  &lt;/header&gt;

  &lt;section class="card-grid"&gt;
    &lt;article&gt;...&lt;/article&gt;
    &lt;article&gt;...&lt;/article&gt;
  &lt;/section&gt;
&lt;/main&gt;</code></pre>
    </section>
  </main>
</BaseLayout>

<style>
  .style-page {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .hero {
    max-width: 780px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0;
    color: #a78bfa;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0.75rem 0 0;
    color: #f8fafc;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero p:not(.eyebrow) {
    max-width: 700px;
    margin: 1.25rem 0 0;
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .section-block {
    margin-top: 4rem;
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    margin: 0.35rem 0 0;
    color: #f8fafc;
    font-size: 1.6rem;
  }

  .type-card,
  .card-grid article,
  .button-card,
  pre {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.55);
  }

  .type-card,
  .card-grid article,
  .button-card {
    padding: 1.25rem;
  }

  .hero-title {
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1;
  }

  .section-title {
    margin: 1.5rem 0 0;
    color: #e2e8f0;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .card-title {
    margin: 1rem 0 0;
    color: #e2e8f0;
    font-size: 1rem;
    font-weight: 700;
  }

  .body-copy {
    max-width: 680px;
    margin: 1rem 0 0;
    color: #94a3b8;
    line-height: 1.7;
  }

  .small-note {
    margin: 1rem 0 0;
    color: #64748b;
    font-family: monospace;
    font-size: 0.75rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .icon {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 0.75rem;
    background: rgba(167, 139, 250, 0.08);
    font-size: 1.3rem;
  }

  .card-grid h3 {
    margin: 0.75rem 0 0;
    color: #e2e8f0;
  }

  .card-grid p:not(.eyebrow) {
    margin: 0.75rem 0 0;
    color: #94a3b8;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .button-card {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    padding: 0.85rem 1.1rem;
    border-radius: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-button {
    background: #6d28d9;
    color: white;
  }

  .secondary-button {
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #e2e8f0;
  }

  .text-link {
    color: #ddd6fe;
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  pre {
    overflow-x: auto;
    padding: 1.25rem;
  }

  code {
    color: #cbd5e1;
    font-family: monospace;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
