---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const tool = {
  title: "Domain Lookup",
  description:
    "Look up A, AAAA, MX, CNAME, NS and TXT records using Google Public DNS.",
  category: "Networking",
  icon: "🌐",
  status: "Available",
  order: 2,
};
---

<BaseLayout title={tool.title}>
  <main class="tool-page">
    <a class="back-link" href="/tools/">
      <span aria-hidden="true">←</span>
      Back to tools
    </a>

    <header class="tool-header">
      <div class="tool-icon" aria-hidden="true">
        {tool.icon}
      </div>

      <div class="header-content">
        <div class="metadata">
          <span class="category">{tool.category}</span>
          <span class="status">{tool.status}</span>
        </div>

        <h1>{tool.title}</h1>

        <p>
          Query common DNS records for a domain using Google Public DNS over
          HTTPS.
        </p>

        <p class="last-updated">Last updated: July 2026</p>
      </div>
    </header>

    <section class="workspace">
      <form id="lookup-form" class="lookup-panel" novalidate>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">DNS query</p>
            <h2>Enter a domain</h2>
          </div>

          <button id="reset-button" class="reset-button" type="reset">
            Reset
          </button>
        </div>

        <label class="field" for="domain">
          <span>Domain name</span>

          <small>
            Enter a hostname without <code>https://</code> or a path.
          </small>

          <input
            id="domain"
            name="domain"
            type="text"
            placeholder="example.com"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
          />
        </label>

        <button id="lookup-button" class="lookup-button" type="submit">
          <span id="button-text">Lookup domain</span>
          <span aria-hidden="true">→</span>
        </button>

        <p id="error-message" class="error-message" role="alert" hidden></p>

        <div class="record-types">
          <p>Records checked</p>

          <div>
            <span>A</span>
            <span>AAAA</span>
            <span>MX</span>
            <span>CNAME</span>
            <span>NS</span>
            <span>TXT</span>
          </div>
        </div>
      </form>

      <section class="results-panel" aria-live="polite">
        <div id="empty-state" class="empty-state">
          <div class="empty-icon" aria-hidden="true">🔎</div>

          <p class="eyebrow">Results</p>
          <h2>Ready for a lookup</h2>

          <p>
            Enter a domain to retrieve its publicly available DNS records.
          </p>
        </div>

        <div id="results-content" class="results-content" hidden>
          <div class="results-header">
            <div>
              <p class="eyebrow">Lookup results</p>
              <h2 id="result-domain">Domain</h2>
            </div>

            <span id="result-count" class="result-count"></span>
          </div>

          <div class="result-grid">
            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">A</span>
                <h3>IPv4 addresses</h3>
              </div>

              <div id="a-results" class="record-values"></div>
            </article>

            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">AAAA</span>
                <h3>IPv6 addresses</h3>
              </div>

              <div id="aaaa-results" class="record-values"></div>
            </article>

            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">MX</span>
                <h3>Mail servers</h3>
              </div>

              <div id="mx-results" class="record-values"></div>
            </article>

            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">CNAME</span>
                <h3>Canonical names</h3>
              </div>

              <div id="cname-results" class="record-values"></div>
            </article>

            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">NS</span>
                <h3>Name servers</h3>
              </div>

              <div id="ns-results" class="record-values"></div>
            </article>

            <article class="result-card">
              <div class="record-heading">
                <span class="record-type">TXT</span>
                <h3>Text records</h3>
              </div>

              <div id="txt-results" class="record-values"></div>
            </article>
          </div>
        </div>
      </section>
    </section>

    <section class="information-panel">
      <div>
        <p class="eyebrow">Limitations</p>
        <h2>Public DNS only</h2>
      </div>

      <div class="information-grid">
        <article>
          <strong>Resolver view</strong>
          <p>
            Results come from Google Public DNS and may differ from another
            resolver, split-horizon DNS, or internal DNS.
          </p>
        </article>

        <article>
          <strong>Not a security verdict</strong>
          <p>
            This tool shows DNS records only. It does not decide whether a
            domain is malicious, safe, or correctly configured.
          </p>
        </article>
      </div>
    </section>

    <section class="information-panel">
      <div>
        <p class="eyebrow">About this tool</p>
        <h2>What the records mean</h2>
      </div>

      <div class="information-grid">
        <article>
          <strong>A and AAAA</strong>
          <p>
            Map a domain to its IPv4 and IPv6 addresses.
          </p>
        </article>

        <article>
          <strong>MX</strong>
          <p>
            Identifies the servers responsible for receiving email.
          </p>
        </article>

        <article>
          <strong>CNAME</strong>
          <p>
            Points one hostname to another canonical hostname.
          </p>
        </article>

        <article>
          <strong>NS and TXT</strong>
          <p>
            Show authoritative name servers and text-based configuration data.
          </p>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("lookup-form");
  const domainInput = document.getElementById("domain");
  const lookupButton = document.getElementById("lookup-button");
  const buttonText = document.getElementById("button-text");
  const errorMessage = document.getElementById("error-message");

  const emptyState = document.getElementById("empty-state");
  const resultsContent = document.getElementById("results-content");
  const resultDomain = document.getElementById("result-domain");
  const resultCount = document.getElementById("result-count");

  const resultElements = {
    A: document.getElementById("a-results"),
    AAAA: document.getElementById("aaaa-results"),
    MX: document.getElementById("mx-results"),
    CNAME: document.getElementById("cname-results"),
    NS: document.getElementById("ns-results"),
    TXT: document.getElementById("txt-results"),
  };

  const recordTypes = ["A", "AAAA", "MX", "CNAME", "NS", "TXT"];

  function cleanDomain(value) {
    let domain = value.trim().toLowerCase();

    domain = domain.replace(/^https?:\/\//, "");
    domain = domain.split("/")[0];
    domain = domain.split("?")[0];
    domain = domain.split("#")[0];
    domain = domain.replace(/\.$/, "");

    return domain;
  }

  function isValidDomain(domain) {
    const domainPattern =
      /^(?=.{1,253}$)(?!-)(?:[a-z0-9-]{1,63}\.)+[a-z]{2,63}$/i;

    return domainPattern.test(domain);
  }

  function showError(message) {
    errorMessage.textContent = message;
    errorMessage.hidden = false;
  }

  function clearError() {
    errorMessage.textContent = "";
    errorMessage.hidden = true;
  }

  function setLoading(isLoading) {
    lookupButton.disabled = isLoading;
    domainInput.disabled = isLoading;

    if (isLoading) {
      buttonText.textContent = "Looking up...";
    } else {
      buttonText.textContent = "Lookup domain";
    }
  }

  async function queryRecord(domain, recordType) {
    const url =
      "https://dns.google/resolve?name=" +
      encodeURIComponent(domain) +
      "&type=" +
      encodeURIComponent(recordType);

    const response = await fetch(url, {
      headers: {
        Accept: "application/dns-json",
      },
    });

    if (!response.ok) {
      throw new Error("DNS request failed with status " + response.status);
    }

    const data = await response.json();

    if (!data.Answer || !Array.isArray(data.Answer)) {
      return [];
    }

    return data.Answer.map(function (record) {
      return {
        value: String(record.data || ""),
        ttl: Number(record.TTL || 0),
      };
    });
  }

  function createRecordElement(record, recordType) {
    const row = document.createElement("div");
    row.className = "record-row";

    const value = document.createElement("code");

    let displayedValue = record.value;

    if (recordType === "TXT") {
      displayedValue = displayedValue.replace(/^"|"$/g, "");
    }

    value.textContent = displayedValue;

    const ttl = document.createElement("span");
    ttl.textContent = record.ttl ? "TTL " + record.ttl + "s" : "";

    row.appendChild(value);
    row.appendChild(ttl);

    return row;
  }

  function displayRecords(recordType, records) {
    const container = resultElements[recordType];

    if (!container) {
      return;
    }

    container.innerHTML = "";

    if (records.length === 0) {
      const empty = document.createElement("p");
      empty.className = "no-records";
      empty.textContent = "No records found.";
      container.appendChild(empty);
      return;
    }

    records.forEach(function (record) {
      container.appendChild(createRecordElement(record, recordType));
    });
  }

  function showResults(domain, recordGroups) {
    let totalRecords = 0;

    recordTypes.forEach(function (recordType) {
      const records = recordGroups[recordType] || [];

      totalRecords += records.length;
      displayRecords(recordType, records);
    });

    resultDomain.textContent = domain;

    resultCount.textContent =
      totalRecords +
      " " +
      (totalRecords === 1 ? "record" : "records");

    emptyState.hidden = true;
    resultsContent.hidden = false;
  }

  function resetResults() {
    clearError();

    emptyState.hidden = false;
    resultsContent.hidden = true;

    resultDomain.textContent = "Domain";
    resultCount.textContent = "";

    recordTypes.forEach(function (recordType) {
      const container = resultElements[recordType];

      if (container) {
        container.innerHTML = "";
      }
    });
  }

  form.addEventListener("submit", async function (event) {
    event.preventDefault();
    clearError();

    const domain = cleanDomain(domainInput.value);

    if (!domain) {
      showError("Enter a domain name.");
      domainInput.focus();
      return;
    }

    if (!isValidDomain(domain)) {
      showError(
        "Enter a valid domain such as example.com. Do not include a URL path.",
      );
      domainInput.focus();
      return;
    }

    domainInput.value = domain;
    setLoading(true);

    try {
      const responses = await Promise.all(
        recordTypes.map(function (recordType) {
          return queryRecord(domain, recordType);
        }),
      );

      const recordGroups = {};

      recordTypes.forEach(function (recordType, index) {
        recordGroups[recordType] = responses[index];
      });

      showResults(domain, recordGroups);
    } catch (error) {
      console.error(error);

      showError(
        "The DNS lookup could not be completed. Check your connection and try again.",
      );
    } finally {
      setLoading(false);
    }
  });

  form.addEventListener("reset", function () {
    window.setTimeout(function () {
      resetResults();
      domainInput.focus();
    }, 0);
  });
</script>

<style>
  .tool-page {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.5rem 0 6rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    color: #94a3b8;
    font-family: monospace;
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .back-link:hover {
    color: #ddd6fe;
  }

  .back-link:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 3px;
  }

  .tool-header {
    display: flex;
    max-width: 850px;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .tool-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 1rem;
    background: rgba(167, 139, 250, 0.08);
    font-size: 1.75rem;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.8rem;
  }

  .category,
  .status,
  .eyebrow {
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category,
  .eyebrow {
    color: #a78bfa;
  }

  .status {
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(134, 239, 172, 0.3);
    border-radius: 999px;
    background: rgba(134, 239, 172, 0.08);
    color: #86efac;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .header-content > p {
    max-width: 700px;
    margin: 1rem 0 0;
    color: #94a3b8;
    line-height: 1.75;
  }

  .header-content .last-updated {
    margin-top: 0.8rem;
    color: #64748b;
    font-family: monospace;
    font-size: 0.72rem;
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.5fr);
    gap: 1.25rem;
    align-items: start;
  }

  .lookup-panel,
  .results-panel,
  .information-panel {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.55);
  }

  .lookup-panel {
    position: sticky;
    top: 1.5rem;
    padding: 1.5rem;
  }

  .panel-heading,
  .results-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .eyebrow {
    margin: 0;
  }

  .panel-heading h2,
  .results-header h2,
  .empty-state h2,
  .information-panel h2 {
    margin: 0.35rem 0 0;
    font-size: 1.3rem;
  }

  .reset-button {
    padding: 0;
    border: 0;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    font-family: monospace;
    font-size: 0.75rem;
  }

  .reset-button:hover {
    color: #e2e8f0;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .field > span {
    color: #e2e8f0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .field small {
    color: #64748b;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .field code {
    color: #94a3b8;
    font-size: inherit;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.7rem;
    background: rgba(2, 6, 23, 0.45);
    color: #f8fafc;
    font: inherit;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  input::placeholder {
    color: #475569;
  }

  input:focus {
    border-color: rgba(167, 139, 250, 0.8);
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.12);
    outline: none;
  }

  input:disabled {
