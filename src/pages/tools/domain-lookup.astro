    border: 1px solid rgba(167, 139, 250, 0.5);
    border-radius: 0.7rem;
    background: #6d28d9;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    transition:
      background 160ms ease,
      transform 160ms ease;
  }

  .lookup-button:hover {
    transform: translateY(-1px);
    background: #5b21b6;
  }

  .lookup-button:disabled {
    cursor: wait;
    opacity: 0.7;
    transform: none;
  }

  .error-message {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(248, 113, 113, 0.3);
    border-radius: 0.7rem;
    background: rgba(248, 113, 113, 0.08);
    color: #fca5a5;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .record-types {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .record-types > p {
    margin: 0 0 0.75rem;
    color: #64748b;
    font-size: 0.72rem;
  }

  .record-types div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .record-types span {
    padding: 0.3rem 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 0.4rem;
    color: #94a3b8;
    font-family: monospace;
    font-size: 0.66rem;
  }

  .results-panel {
    min-height: 480px;
    padding: 1.5rem;
  }

  .empty-state {
    display: flex;
    min-height: 430px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .empty-icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 1rem;
    background: rgba(167, 139, 250, 0.08);
    font-size: 1.5rem;
  }

  .empty-state > p:last-child {
    max-width: 360px;
    margin: 0.85rem 0 0;
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .result-count {
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.08);
    color: #ddd6fe;
    font-family: monospace;
    font-size: 0.67rem;
    white-space: nowrap;
  }

  .result-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .result-card {
    min-width: 0;
    padding: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 0.75rem;
    background: rgba(2, 6, 23, 0.28);
  }

  .record-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .record-heading h3 {
    margin: 0;
    color: #e2e8f0;
    font-size: 0.85rem;
  }

  .record-type {
    display: grid;
    min-width: 2.2rem;
    height: 1.75rem;
    padding: 0 0.4rem;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 0.4rem;
    background: rgba(167, 139, 250, 0.08);
    color: #ddd6fe;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .record-values {
    display: grid;
    gap: 0.55rem;
  }

  .record-values :global(.record-row) {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  }

  .record-values :global(.record-row:last-child) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .record-values :global(code) {
    overflow-wrap: anywhere;
    color: #cbd5e1;
    font-family: monospace;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .record-values :global(.record-row span) {
    color: #475569;
    font-family: monospace;
    font-size: 0.62rem;
  }

  .record-values :global(.no-records) {
    margin: 0;
    color: #64748b;
    font-size: 0.78rem;
  }

  .information-panel {
    display: grid;
    grid-template-columns: minmax(190px, 0.55fr) minmax(0, 1.45fr);
    gap: 2rem;
    margin-top: 1.25rem;
    padding: 1.5rem;
  }

  .information-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .information-grid article {
    padding-left: 1rem;
    border-left: 1px solid rgba(148, 163, 184, 0.18);
  }

  .information-grid strong {
    color: #e2e8f0;
    font-size: 0.82rem;
  }

  .information-grid p {
    margin: 0.45rem 0 0;
    color: #64748b;
    font-size: 0.76rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .workspace {
      grid-template-columns: 1fr;
    }

    .lookup-panel {
      position: static;
    }

    .results-panel {
      min-height: 400px;
    }

    .empty-state {
      min-height: 350px;
    }
  }

  @media (max-width: 680px) {
    .tool-page {
      padding-top: 1.5rem;
    }

    .tool-header {
      flex-direction: column;
    }

    .result-grid,
    .information-panel,
    .information-grid {
      grid-template-columns: 1fr;
    }

    .results-header {
      flex-direction: column;
    }

    .information-grid article {
      padding: 1rem 0 0;
      border-top: 1px solid rgba(148, 163, 184, 0.18);
      border-left: 0;
    }

    .information-grid article:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
