---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Certifications — Elliot Buckland-Weir";
const description =
  "Cybersecurity certifications and current learning record from Elliot Buckland-Weir, including verified TryHackMe and Microsoft credentials, completed SAL1 certification, and planned SC-300 identity learning.";

const certifications = [
  {
    date: "15 August 2026",
    expires: "15 August 2029",
    title: "Cyber Security 101 (SEC1)",
    shortTitle: "Cyber Security 101 (SEC1)",
    issuer: "TryHackMe",
    status: "Verified",
    level: "Entry-level",
    description:
      "Professional certification validating foundational cyber security knowledge through a structured assessment, including networking, operating systems, and essential security principles.",
    image: "/cyber-security-101-sec1.png",
    badgeId: "e3bbcd17-4240-450c-9c33-3b481562ad26",
    credly:
      "https://www.credly.com/badges/e3bbcd17-4240-450c-9c33-3b481562ad26/public_url",
    skills: [
      "Cyber Security Fundamentals",
      "Networking",
      "Operating Systems",
      "Security Principles",
      "Technical Assessment",
      "Entry-Level Security Knowledge",
    ],
  },
  {
    date: "June 2026",
    expires: "June 2029",
    title: "TryHackMe Certified Pre Security (SEC0)",
    shortTitle: "Pre Security (SEC0)",
    issuer: "TryHackMe",
    status: "Verified",
    level: "Foundation",
    description:
      "Foundation-level certification covering computer systems, operating systems, networking, web technologies, and core cybersecurity concepts.",
    image: "/pre-security-sec0.png",
    badgeId: "9634e68e-1e13-49e6-8db6-b346937df0cb",
    credly:
      "https://www.credly.com/badges/9634e68e-1e13-49e6-8db6-b346937df0cb/public_url",
    skills: [
      "Computer Fundamentals",
      "Operating Systems",
      "Networking Fundamentals",
      "Web Technologies",
      "Cyber Security Fundamentals",
      "Security Awareness",
    ],
  },
];

const microsoftCredential = {
  date: "August 2026",
  title: "Get started with identities and access using Microsoft Entra",
  shortTitle: "Microsoft Entra Identity and Access",
  issuer: "Microsoft Applied Skills",
  status: "Verified",
  level: "Identity and access fundamentals",
  href: "https://learn.microsoft.com/api/credentials/share/en-gb/ElliotBucklandWeir-2692/8949141E3308EF55?sharingId=6D06B25344696111",
  description:
    "Microsoft Applied Skills credential focused on getting started with identities and access using Microsoft Entra, supporting my work around identity controls, Conditional Access, and access management.",
  skills: [
    "Microsoft Entra",
    "Identity and Access",
    "Conditional Access",
    "Access Management",
    "Microsoft Learn",
    "Identity Security",
  ],
};

const adDsCredential = {
  date: "August 2026",
  title: "Administer Active Directory Domain Services",
  shortTitle: "Active Directory Domain Services",
  issuer: "Microsoft Applied Skills",
  status: "Verified",
  level: "Intermediate Active Directory administration",
  href: "https://learn.microsoft.com/api/credentials/share/en-gb/ElliotBucklandWeir-2692/1454017439CFE08B?sharingId=6D06B25344696111",
  description:
    "Microsoft Applied Skills credential demonstrating hands-on administration of Active Directory Domain Services, including domain controllers, topology, objects, Group Policy, and security controls.",
  skills: [
    "Active Directory Domain Services",
    "Domain Controllers",
    "Sites and Replication",
    "Group Policy",
    "FSMO Roles",
    "AD Security",
  ],
};

const sal1Certification = {
  date: "14 October 2026",
  title: "Security Analyst Level 1 (SAL1)",
  issuer: "TryHackMe",
  status: "Verified",
  level: "Entry-level SOC analyst",
  image: "/sal1-badge.png",
  href: "https://www.credly.com/badges/4d59b051-13bc-4d77-aabe-ccc467c97e9e/public_url",
  description:
    "Passed TryHackMe Security Analyst Level 1, strengthening my skills in SOC fundamentals, alert triage, threat detection, practical investigation, and analyst report writing.",
  skills: [
    "SOC Simulation",
    "Alert Triage",
    "Threat Detection",
    "Cyber Defence Frameworks",
    "Case Report Writing",
    "Analyst Mindset",
  ],
};

const plannedCertification = {
  title: "Microsoft SC-300",
  fullTitle: "Microsoft Identity and Access Administrator Associate",
  issuer: "Microsoft",
  status: "Planned next focus - not awarded",
  level: "Intermediate identity and access",
  href: "https://learn.microsoft.com/en-us/credentials/certifications/identity-and-access-administrator/",
  description:
    "Having passed SAL1, I’m planning to study Microsoft SC-300 to deepen practical knowledge of Microsoft Entra ID, Conditional Access, identity governance, privileged access, access reviews, and Zero Trust identity controls.",
  skills: [
    "Microsoft Entra ID",
    "Conditional Access",
    "Identity Governance",
    "Privileged Identity Management",
    "Access Reviews",
    "Zero Trust Identity",
  ],
};

const learningFocus = [
  {
    title: "Security Fundamentals",
    description:
      "Building the basics properly across systems, networking, web, and security.",
  },
  {
    title: "Hands-on Practice",
    description: "Using labs so the theory does not stay abstract.",
  },
  {
    title: "Blue Team Progression",
    description:
      "Working towards stronger skills in security operations, Microsoft 365, identity, and automation.",
  },
  {
    title: "Infrastructure as Code",
    description:
      "Exploring Infrastructure as Code (IaC), with a focus on repeatable configuration, version-controlled infrastructure, and secure deployment practices.",
  },
];
---

<BaseLayout {title} {description} path="/certifications/">
  <main class="cert-page">
    <section class="hero">
      <p class="eyebrow">Learning record</p>

      <h1>Certifications</h1>

      <p>
        A simple record of the certifications and learning I’m using to build
        my security knowledge.
      </p>
    </section>

    <section class="overview-grid" aria-label="Certification summary">
      <article>
        <span>Verified credentials</span>
        <strong>{certifications.length + 3}</strong>
        <p>Currently listed and linked to public verification pages.</p>
      </article>

      <article>
        <span>Professional experience</span>
        <strong>5 years</strong>
        <p>Across IT operations, support, and security engineering.</p>
      </article>

      <article>
        <span>Latest issuer</span>
        <strong>TryHackMe</strong>
        <p>Passed Security Analyst Level 1 (SAL1).</p>
      </article>

      <article>
        <span>Learning path</span>
        <strong>SAL1 → SC-300</strong>
        <p>SAL1 passed, with identity and access learning planned next.</p>
      </article>
    </section>

    <section class="featured-cert" aria-label="Verified SAL1 certification">
      <div class="badge-panel verified-badge-panel">
        <img
          src={sal1Certification.image}
          alt={`${sal1Certification.title} badge`}
          loading="lazy"
        />

        <span class="verified-overlay">Verified credential</span>

        <a
          class="credential-link"
          href={sal1Certification.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          View verified credential
        </a>
      </div>

      <div class="cert-details">
        <div class="cert-meta">
          <span>{sal1Certification.issuer}</span>
          <span>{sal1Certification.status}</span>
        </div>

        <h2>{sal1Certification.title}</h2>

        <p>{sal1Certification.description}</p>

        <div class="fact-grid">
          <div>
            <span>Passed</span>
            <strong>{sal1Certification.date}</strong>
          </div>

          <div>
            <span>Level</span>
            <strong>{sal1Certification.level}</strong>
          </div>

          <div>
            <span>Verification</span>
            <strong>Credly</strong>
          </div>
        </div>

        <div class="skills-block">
          <h3>Skills demonstrated</h3>

          <div class="skills">
            {sal1Certification.skills.map((skill) => (
              <span>{skill}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="credential-collection" aria-labelledby="verified-credentials-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Verified learning</p>
          <h2 id="verified-credentials-heading">Microsoft Applied Skills</h2>
        </div>

        <p>
          Compact records of the practical Microsoft credentials supporting my
          identity and Active Directory work.
        </p>
      </div>

      <div class="credential-grid">
        {[adDsCredential, microsoftCredential].map((credential) => (
          <article class="compact-cert">
            <div class="compact-cert-heading">
              <img
                src="/microsoft-applied-skills.svg"
                alt=""
                aria-hidden="true"
                loading="lazy"
              />

              <div class="cert-meta cert-meta-microsoft">
                <span>{credential.issuer}</span>
                <span>{credential.status}</span>
              </div>
            </div>

            <h3>{credential.title}</h3>
            <p>{credential.description}</p>

            <dl class="compact-facts">
              <div>
                <dt>Issued</dt>
                <dd>{credential.date}</dd>
              </div>
              <div>
                <dt>Focus</dt>
                <dd>{credential.level}</dd>
              </div>
            </dl>

            <div class="skills compact-skills">
              {credential.skills.slice(0, 4).map((skill) => (
                <span>{skill}</span>
              ))}
            </div>

            <a
              class="credential-link compact-credential-link"
              href={credential.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              View verified credential
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="planned-cert" aria-label="Certification planned next">
      <div class="planned-icon-panel">
        <span aria-hidden="true">ID</span>
        <p>Planned next focus</p>

        <a
          class="credential-link"
          href={plannedCertification.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          View Microsoft SC-300 page
        </a>
      </div>

      <div class="cert-details">
        <div class="cert-meta cert-meta-planned">
          <span>{plannedCertification.issuer}</span>
          <span>{plannedCertification.status}</span>
        </div>

        <h2>{plannedCertification.title}</h2>

        <p>
          <strong>{plannedCertification.fullTitle}</strong> — {plannedCertification.description}
        </p>

        <div class="fact-grid">
          <div>
            <span>Status</span>
            <strong>Planned</strong>
          </div>

          <div>
            <span>Awarded</span>
            <strong>Not yet</strong>
          </div>

          <div>
            <span>Focus</span>
            <strong>Identity and access</strong>
          </div>
        </div>

        <div class="skills-block">
          <h3>Planned study areas</h3>

          <div class="skills">
            {plannedCertification.skills.map((skill) => (
              <span>{skill}</span>
            ))}
          </div>
        </div>

      </div>
    </section>

    <section class="learning-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Development focus</p>
          <h2>What this supports</h2>
        </div>

        <p>
          Certifications are only one part of the site. I use them alongside
          labs, write-ups, tools, and day-to-day work.
        </p>
      </div>

      <div class="learning-grid">
        {learningFocus.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="timeline-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Timeline</p>
          <h2>Certification journey</h2>
        </div>
      </div>

      <div class="timeline">
        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>

          <div class="timeline-card">
            <span class="date">{sal1Certification.date}</span>
            <h3>Security Analyst Level 1 (SAL1)</h3>
            <p>
              Passed SAL1, building practical skills in SOC operations, alert
              triage, threat detection, investigation, and analyst report writing.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker timeline-marker-microsoft" aria-hidden="true"></div>

          <div class="timeline-card timeline-card-microsoft">
            <span class="date">{adDsCredential.date}</span>
            <h3>{adDsCredential.shortTitle}</h3>
            <p>
              Earned the <strong>{adDsCredential.title}</strong> Microsoft
              Applied Skills credential, demonstrating practical Active
              Directory administration and security skills.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker timeline-marker-microsoft" aria-hidden="true"></div>

          <div class="timeline-card timeline-card-microsoft">
            <span class="date">{microsoftCredential.date}</span>
            <h3>{microsoftCredential.shortTitle}</h3>
            <p>
              Earned the <strong>{microsoftCredential.title}</strong>
              Microsoft Applied Skills credential, supporting my identity and
              access learning path.
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-marker timeline-marker-planned" aria-hidden="true"></div>

          <div class="timeline-card timeline-card-planned">
            <span class="date">Planned next</span>
            <h3>Microsoft SC-300</h3>
            <p>
              Planned next focus following my SAL1 pass, aimed at strengthening Microsoft
              identity, Conditional Access, privileged access, and governance
              knowledge. This certification has not yet been awarded.
            </p>
          </div>
        </article>

        {certifications.map((cert) => (
          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-card">
              <span class="date">{cert.date}</span>
              <h3>{cert.shortTitle}</h3>
              <p>
                Earned the <strong>{cert.title}</strong> certification,
                validating practical cybersecurity knowledge.
              </p>

              {cert.expires && (
                <p class="timeline-validity">
                  Valid until <strong>{cert.expires}</strong>.
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <style>
    .cert-page {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 4rem 0 6rem;
    }

    .hero {
      max-width: 780px;
      margin-bottom: 2.5rem;
    }

    .eyebrow {
      margin: 0;
      color: #a78bfa;
      font-family: monospace;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 0.75rem 0 0;
      color: #f8fafc;
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .hero p {
      max-width: 700px;
      margin: 1.25rem 0 0;
      color: #94a3b8;
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .overview-grid,
    .learning-grid {
      display: grid;
      gap: 1rem;
    }

    .overview-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .learning-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .overview-grid article,
    .featured-cert,
    .current-cert,
    .planned-cert,
    .compact-cert,
    .learning-grid article,
    .timeline-card {
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.55);
    }

    .overview-grid article {
      padding: 1.25rem;
    }

    .overview-grid span,
    .fact-grid span {
      color: #64748b;
      font-size: 0.75rem;
    }

    .overview-grid strong {
      display: block;
      margin-top: 0.35rem;
      color: #f8fafc;
      font-size: 1.6rem;
      line-height: 1.1;
    }

    .overview-grid p {
      margin: 0.8rem 0 0;
      color: #94a3b8;
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .featured-cert,
    .current-cert,
    .planned-cert {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
      margin-top: 1.5rem;
      padding: 2rem;
    }

    .current-cert {
      border-color: rgba(251, 191, 36, 0.32);
      background:
        linear-gradient(145deg, rgba(251, 191, 36, 0.08), transparent 44%),
        rgba(15, 23, 42, 0.55);
    }

    .planned-cert {
      border-color: rgba(167, 139, 250, 0.28);
      background:
        linear-gradient(145deg, rgba(167, 139, 250, 0.1), transparent 44%),
        rgba(15, 23, 42, 0.55);
    }

    .badge-panel,
    .current-badge-panel {
      display: grid;
      justify-items: center;
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.14);
      border-radius: 0.85rem;
      background: rgba(2, 6, 23, 0.3);
    }

    .current-badge-panel img {
      width: min(190px, 100%);
      height: auto;
      opacity: 0.78;
      filter: saturate(0.85);
    }

    .verified-badge-panel img {
      width: min(190px, 100%);
      height: auto;
    }

    .in-progress-overlay,
    .verified-overlay {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 0.55rem 0.7rem;
      border: 1px solid rgba(251, 191, 36, 0.45);
      border-radius: 0.65rem;
      background: rgba(2, 6, 23, 0.88);
      color: #fcd34d;
      font-family: monospace;
      font-size: 0.66rem;
      font-weight: 800;
      text-align: center;
      text-transform: uppercase;
    }

    .verified-overlay {
      border-color: rgba(134, 239, 172, 0.45);
      color: #86efac;
    }

    .planned-icon-panel {
      display: grid;
      min-height: 220px;
      place-items: center;
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid rgba(167, 139, 250, 0.18);
      border-radius: 0.85rem;
      background:
        radial-gradient(circle at 50% 35%, rgba(167, 139, 250, 0.18), transparent 7rem),
        rgba(2, 6, 23, 0.3);
      text-align: center;
    }

    .badge-panel,
    .planned-icon-panel {
      row-gap: 1.5rem;
      align-content: center;
    }

    .planned-icon-panel span {
      display: grid;
      width: 7.5rem;
      height: 7.5rem;
      place-items: center;
      border: 1px solid rgba(167, 139, 250, 0.35);
      border-radius: 1.4rem;
      background: rgba(109, 40, 217, 0.18);
      color: #ddd6fe;
      font-family: monospace;
      font-size: 2.6rem;
      font-weight: 900;
      letter-spacing: 0.04em;
    }

    .planned-icon-panel p {
      margin: 0;
      color: #c4b5fd;
      font-family: monospace;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .credential-link {
      display: inline-flex;
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1rem;
      border: 1px solid rgba(167, 139, 250, 0.5);
      border-radius: 0.7rem;
      background: rgba(109, 40, 217, 0.85);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      transition:
        background 160ms ease,
        transform 160ms ease;
    }

    .credential-link:hover {
      transform: translateY(-1px);
      background: rgba(109, 40, 217, 1);
    }

    .cert-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }

    .cert-meta span {
      padding: 0.35rem 0.65rem;
      border: 1px solid rgba(134, 239, 172, 0.25);
      border-radius: 999px;
      background: rgba(134, 239, 172, 0.08);
      color: #86efac;
      font-family: monospace;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .cert-meta-progress span {
      border-color: rgba(251, 191, 36, 0.32);
      background: rgba(251, 191, 36, 0.08);
      color: #fcd34d;
    }

    .cert-meta-planned span {
      border-color: rgba(167, 139, 250, 0.32);
      background: rgba(167, 139, 250, 0.08);
      color: #c4b5fd;
    }

    .cert-meta-microsoft span {
      border-color: rgba(96, 165, 250, 0.32);
      background: rgba(96, 165, 250, 0.08);
      color: #bfdbfe;
    }

    .cert-details h2 {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      line-height: 1.1;
    }

    .cert-details > p {
      margin: 1rem 0 0;
      color: #cbd5e1;
      line-height: 1.75;
    }

    .cert-details > p strong {
      color: #f8fafc;
    }

    .fact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .fact-grid div {
      padding: 1rem;
      border: 1px solid rgba(148, 163, 184, 0.14);
      border-radius: 0.75rem;
      background: rgba(2, 6, 23, 0.28);
    }

    .fact-grid strong {
      display: block;
      margin-top: 0.4rem;
      color: #e2e8f0;
      font-size: 0.95rem;
    }

    .skills-block {
      margin-top: 1.5rem;
    }

    .external-cert-link {
      width: auto;
      margin-top: 1.5rem;
    }

    .skills-block h3 {
      margin: 0;
      color: #e2e8f0;
      font-size: 1rem;
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 0.9rem;
    }

    .skills span {
      padding: 0.45rem 0.7rem;
      border: 1px solid rgba(167, 139, 250, 0.2);
      border-radius: 999px;
      background: rgba(167, 139, 250, 0.08);
      color: #bfdbfe;
      font-size: 0.78rem;
    }

    .learning-section,
    .timeline-section {
      margin-top: 4rem;
    }

    .credential-collection {
      margin-top: 4rem;
    }

    .credential-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .compact-cert {
      display: flex;
      min-height: 100%;
      flex-direction: column;
      padding: 1.5rem;
      border-color: rgba(96, 165, 250, 0.3);
      background:
        linear-gradient(145deg, rgba(96, 165, 250, 0.1), transparent 48%),
        rgba(15, 23, 42, 0.55);
    }

    .compact-cert-heading {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .compact-cert-heading img {
      width: 3rem;
      height: 3rem;
      flex: 0 0 auto;
    }

    .compact-cert-heading .cert-meta {
      margin: 0;
    }

    .compact-cert h3 {
      margin: 1.25rem 0 0;
      color: #f8fafc;
      font-size: clamp(1.25rem, 2.5vw, 1.65rem);
      line-height: 1.2;
    }

    .compact-cert > p {
      margin: 0.85rem 0 0;
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .compact-facts {
      display: grid;
