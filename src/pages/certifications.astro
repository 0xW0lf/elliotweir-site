---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Certifications — Elliot Buckland-Weir";
const description =
  "Cybersecurity certifications and current learning record from Elliot Buckland-Weir, including verified credentials and in-progress SAL1 study.";

const certifications = [
  {
    date: "June 2026",
    title: "TryHackMe Certified Pre Security (SEC0)",
    shortTitle: "Pre Security (SEC0)",
    issuer: "TryHackMe",
    status: "Verified",
    level: "Foundation",
    description:
      "Foundation-level certification covering computer systems, operating systems, networking, web technologies, and core cybersecurity concepts.",
    image: "/pre-security-sec0.png",
    badgeId: "9634e68e-1e13-49e6-8db6-b346937df0cb",
    credly:
      "https://www.credly.com/badges/9634e68e-1e13-49e6-8db6-b346937df0cb/public_url",
    skills: [
      "Computer Fundamentals",
      "Operating Systems",
      "Networking Fundamentals",
      "Web Technologies",
      "Cyber Security Fundamentals",
      "Security Awareness",
    ],
  },
];

const featuredCertification = certifications[0];

const currentCertification = {
  title: "Security Analyst Level 1 (SAL1)",
  issuer: "TryHackMe",
  status: "In progress - not awarded",
  level: "Entry-level SOC analyst",
  started: "In progress",
  image: "/sal1-badge.png",
  href: "https://tryhackme.com/certification/security-analyst-level-1",
  description:
    "Currently working towards TryHackMe Security Analyst Level 1. This is not yet awarded; I’m using the pathway to strengthen SOC fundamentals, alert triage, threat detection, practical investigation, and analyst report writing.",
  skills: [
    "SOC Simulation",
    "Alert Triage",
    "Threat Detection",
    "Cyber Defence Frameworks",
    "Case Report Writing",
    "Analyst Mindset",
  ],
};

const learningFocus = [
  {
    title: "Security Fundamentals",
    description:
      "Building the basics properly across systems, networking, web, and security.",
  },
  {
    title: "Hands-on Practice",
    description: "Using labs so the theory does not stay abstract.",
  },
  {
    title: "Blue Team Progression",
    description:
      "Working towards stronger skills in security operations, Microsoft 365, identity, and automation.",
  },
];
---

<BaseLayout {title} {description} path="/certifications/">
  <main class="cert-page">
    <section class="hero">
      <p class="eyebrow">Learning record</p>

      <h1>Certifications</h1>

      <p>
        A simple record of the certifications and learning I’m using to build
        my security knowledge.
      </p>
    </section>

    <section class="overview-grid" aria-label="Certification summary">
      <article>
        <span>Verified certs</span>
        <strong>{certifications.length}</strong>
        <p>Currently listed and linked to a public credential.</p>
      </article>

      <article>
        <span>Current level</span>
        <strong>{featuredCertification.level}</strong>
        <p>Focused on getting the basics right.</p>
      </article>

      <article>
        <span>Latest issuer</span>
        <strong>{featuredCertification.issuer}</strong>
        <p>Hands-on learning through TryHackMe labs.</p>
      </article>

      <article>
        <span>Working towards</span>
        <strong>SAL1</strong>
        <p>Clearly marked as in progress and not yet awarded.</p>
      </article>
    </section>

    <section class="current-cert" aria-label="Certification currently in progress">
      <div class="current-badge-panel">
        <img
          src={currentCertification.image}
          alt="TryHackMe Security Analyst Level 1 SAL1 badge"
          loading="lazy"
        />

        <span class="in-progress-overlay">In progress - not awarded</span>
      </div>

      <div class="cert-details">
        <div class="cert-meta cert-meta-progress">
          <span>{currentCertification.issuer}</span>
          <span>{currentCertification.status}</span>
        </div>

        <h2>{currentCertification.title}</h2>

        <p>{currentCertification.description}</p>

        <div class="fact-grid">
          <div>
            <span>Status</span>
            <strong>{currentCertification.started}</strong>
          </div>

          <div>
            <span>Awarded</span>
            <strong>Not yet</strong>
          </div>

          <div>
            <span>Level</span>
            <strong>{currentCertification.level}</strong>
          </div>
        </div>

        <div class="skills-block">
          <h3>Study focus</h3>

          <div class="skills">
            {currentCertification.skills.map((skill) => (
              <span>{skill}</span>
            ))}
          </div>
        </div>

        <a
          class="credential-link external-cert-link"
          href={currentCertification.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          View TryHackMe SAL1 page
        </a>
      </div>
    </section>

    <section class="featured-cert">
      <div class="badge-panel verified-badge-panel">
        <img
          src={featuredCertification.image}
          alt="TryHackMe Certified Pre Security SEC0 badge"
          loading="lazy"
        />

        <span class="verified-overlay">Verified credential</span>

        <a
          class="credential-link"
          href={featuredCertification.credly}
          target="_blank"
          rel="noopener noreferrer"
        >
          View verified credential
        </a>
      </div>

      <div class="cert-details">
        <div class="cert-meta">
          <span>{featuredCertification.issuer}</span>
          <span>{featuredCertification.status}</span>
        </div>

        <h2>{featuredCertification.title}</h2>

        <p>{featuredCertification.description}</p>

        <div class="fact-grid">
          <div>
            <span>Issued</span>
            <strong>{featuredCertification.date}</strong>
          </div>

          <div>
            <span>Level</span>
            <strong>{featuredCertification.level}</strong>
          </div>

          <div>
            <span>Verification</span>
            <strong>Credly</strong>
          </div>
        </div>

        <div class="skills-block">
          <h3>Skills demonstrated</h3>

          <div class="skills">
            {featuredCertification.skills.map((skill) => (
              <span>{skill}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="learning-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Development focus</p>
          <h2>What this supports</h2>
        </div>

        <p>
          Certifications are only one part of the site. I use them alongside
          labs, write-ups, tools, and day-to-day work.
        </p>
      </div>

      <div class="learning-grid">
        {learningFocus.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="timeline-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Timeline</p>
          <h2>Certification journey</h2>
        </div>
      </div>

      <div class="timeline">
        <article class="timeline-item">
          <div class="timeline-marker timeline-marker-progress" aria-hidden="true"></div>

          <div class="timeline-card timeline-card-progress">
            <span class="date">In progress</span>
            <h3>Security Analyst Level 1 (SAL1)</h3>
            <p>
              Currently working towards SAL1. This certification has not yet
              been awarded and is shown here as an active learning goal.
            </p>
          </div>
        </article>

        {certifications.map((cert) => (
          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-card">
              <span class="date">{cert.date}</span>
              <h3>{cert.shortTitle}</h3>
              <p>
                Earned the <strong>{cert.title}</strong> certification,
                validating foundation-level cybersecurity knowledge.
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <style>
    .cert-page {
      width: min(1120px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 4rem 0 6rem;
    }

    .hero {
      max-width: 780px;
      margin-bottom: 2.5rem;
    }

    .eyebrow {
      margin: 0;
      color: #a78bfa;
      font-family: monospace;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 0.75rem 0 0;
      color: #f8fafc;
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .hero p {
      max-width: 700px;
      margin: 1.25rem 0 0;
      color: #94a3b8;
      font-size: 1.05rem;
      line-height: 1.75;
    }

    .overview-grid,
    .learning-grid {
      display: grid;
      gap: 1rem;
    }

    .overview-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .learning-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .overview-grid article,
    .featured-cert,
    .current-cert,
    .learning-grid article,
    .timeline-card {
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 1rem;
      background: rgba(15, 23, 42, 0.55);
    }

    .overview-grid article {
      padding: 1.25rem;
    }

    .overview-grid span,
    .fact-grid span {
      color: #64748b;
      font-size: 0.75rem;
    }

    .overview-grid strong {
      display: block;
      margin-top: 0.35rem;
      color: #f8fafc;
      font-size: 1.6rem;
      line-height: 1.1;
    }

    .overview-grid p {
      margin: 0.8rem 0 0;
      color: #94a3b8;
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .featured-cert,
    .current-cert {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
      margin-top: 1rem;
      padding: 2rem;
    }

    .current-cert {
      border-color: rgba(251, 191, 36, 0.32);
      background:
        linear-gradient(145deg, rgba(251, 191, 36, 0.08), transparent 44%),
        rgba(15, 23, 42, 0.55);
    }

    .badge-panel,
    .current-badge-panel {
      display: grid;
      justify-items: center;
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid rgba(148, 163, 184, 0.14);
      border-radius: 0.85rem;
      background: rgba(2, 6, 23, 0.3);
    }

    .current-badge-panel {
      position: relative;
      overflow: hidden;
    }

    .current-badge-panel img {
      width: min(190px, 100%);
      height: auto;
      opacity: 0.78;
      filter: saturate(0.85);
    }

    .verified-badge-panel {
      position: relative;
      overflow: hidden;
    }

    .verified-badge-panel img {
      width: min(190px, 100%);
      height: auto;
    }

    .in-progress-overlay,
    .verified-overlay {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      padding: 0.55rem 0.7rem;
      border: 1px solid rgba(251, 191, 36, 0.45);
      border-radius: 0.65rem;
      background: rgba(2, 6, 23, 0.88);
      color: #fcd34d;
      font-family: monospace;
      font-size: 0.66rem;
      font-weight: 800;
      text-align: center;
      text-transform: uppercase;
    }

    .verified-overlay {
      border-color: rgba(134, 239, 172, 0.45);
      color: #86efac;
    }

    .credential-link {
      display: inline-flex;
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1rem;
      border: 1px solid rgba(167, 139, 250, 0.5);
      border-radius: 0.7rem;
      background: rgba(109, 40, 217, 0.85);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      transition:
        background 160ms ease,
        transform 160ms ease;
    }

    .credential-link:hover {
      transform: translateY(-1px);
      background: rgba(109, 40, 217, 1);
    }

    .cert-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }

    .cert-meta span {
      padding: 0.35rem 0.65rem;
      border: 1px solid rgba(134, 239, 172, 0.25);
      border-radius: 999px;
      background: rgba(134, 239, 172, 0.08);
      color: #86efac;
      font-family: monospace;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .cert-meta-progress span {
      border-color: rgba(251, 191, 36, 0.32);
      background: rgba(251, 191, 36, 0.08);
      color: #fcd34d;
    }

    .cert-details h2 {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      line-height: 1.1;
    }

    .cert-details > p {
      margin: 1rem 0 0;
      color: #cbd5e1;
      line-height: 1.75;
    }

    .fact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .fact-grid div {
      padding: 1rem;
      border: 1px solid rgba(148, 163, 184, 0.14);
      border-radius: 0.75rem;
      background: rgba(2, 6, 23, 0.28);
    }

    .fact-grid strong {
      display: block;
      margin-top: 0.4rem;
      color: #e2e8f0;
      font-size: 0.95rem;
    }

    .skills-block {
      margin-top: 1.5rem;
    }

    .external-cert-link {
      width: auto;
      margin-top: 1.5rem;
    }

    .skills-block h3 {
      margin: 0;
      color: #e2e8f0;
      font-size: 1rem;
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 0.9rem;
    }

    .skills span {
      padding: 0.45rem 0.7rem;
      border: 1px solid rgba(167, 139, 250, 0.2);
      border-radius: 999px;
      background: rgba(167, 139, 250, 0.08);
      color: #bfdbfe;
      font-size: 0.78rem;
    }

    .learning-section,
    .timeline-section {
      margin-top: 4rem;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 1.25rem;
    }

    .section-heading h2 {
      margin: 0.35rem 0 0;
      color: #f8fafc;
      font-size: 1.6rem;
    }

    .section-heading > p {
      max-width: 520px;
      margin: 0;
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .learning-grid article {
      padding: 1.25rem;
    }

    .learning-grid h3 {
      margin: 0;
      color: #e2e8f0;
      font-size: 1rem;
    }

    .learning-grid p {
      margin: 0.75rem 0 0;
      color: #94a3b8;
      font-size: 0.86rem;
      line-height: 1.65;
    }

    .timeline {
      position: relative;
      display: grid;
      gap: 1rem;
      padding-left: 1.25rem;
      border-left: 1px solid rgba(148, 163, 184, 0.22);
    }

    .timeline-item {
      position: relative;
      padding-left: 1.25rem;
    }

    .timeline-marker {
      position: absolute;
      top: 1.4rem;
      left: -1.69rem;
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 999px;
      background: #a78bfa;
      box-shadow: 0 0 0 5px rgba(167, 139, 250, 0.12);
    }

    .timeline-marker-progress {
      background: #fcd34d;
      box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.12);
    }

    .timeline-card-progress {
      border-color: rgba(251, 191, 36, 0.3);
    }

    .timeline-card {
      padding: 1.25rem;
    }

    .date {
      color: #a78bfa;
      font-family: monospace;
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .timeline-card h3 {
      margin: 0.5rem 0 0;
      color: #e2e8f0;
      font-size: 1.1rem;
    }

    .timeline-card p {
      margin: 0.75rem 0 0;
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    @media (max-width: 860px) {
      .overview-grid,
      .featured-cert,
      .current-cert,
      .learning-grid,
      .section-heading {
        grid-template-columns: 1fr;
      }

      .featured-cert {
        gap: 1.25rem;
      }

      .section-heading {
        display: grid;
        align-items: start;
      }
    }

    @media (max-width: 620px) {
      .cert-page {
        padding-top: 2.5rem;
      }

      .overview-grid,
      .fact-grid {
        grid-template-columns: 1fr;
      }

      .featured-cert {
        padding: 1.25rem;
      }

      .current-cert {
        padding: 1.25rem;
      }
    }
  </style>
</BaseLayout>
