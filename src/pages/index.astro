---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const name = "Elliot Buckland-Weir";
const title = "Elliot Buckland-Weir | Junior Security Analyst Portfolio";
const description =
  "Junior Security Analyst portfolio covering Microsoft 365 security, IAM, Conditional Access, Defender, security operations, SAL1 study, technical research, and browser-based security tools.";

const allPosts = await getCollection("research");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
  )
  .slice(0, 3);

const focusAreas = [
  {
    label: "Microsoft 365",
    title: "Security and admin",
    description:
      "The Microsoft 365 work I spend time around: identity, endpoint management, email security, and sharing controls.",
  },
  {
    label: "Operations",
    title: "Security work",
    description:
      "Alert review, vulnerability remediation, phishing awareness, incident support, and reporting.",
  },
  {
    label: "Tooling",
    title: "Small tools",
    description:
      "Browser tools, workflow helpers, and scripts for things I find myself checking more than once.",
  },
];

const featuredTools = [
  {
    title: "IP Intelligence",
    href: "/tools/ip-lookup",
    category: "Threat Intelligence",
    icon: "🌍",
    description:
      "Check IP location, ASN, RDAP registration, reverse DNS, and possible hosting indicators.",
  },
  {
    title: "Domain Lookup",
    href: "/tools/domain-lookup",
    category: "Networking",
    icon: "🌐",
    description:
      "Look up common DNS records using Google Public DNS.",
  },
  {
    title: "Guest Risk Calculator",
    href: "/tools/guest-risk",
    category: "Identity Security",
    icon: "🧮",
    description:
      "Calculate the percentage of inactive guest accounts.",
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <main>
    <!-- HERO -->
    <section class="home-hero">
      <div class="hero-inner">
        <div class="identity-row">
          <img
            src="/me.jpg"
            alt="Photo of Elliot Buckland-Weir"
            class="profile-image"
          />

          <div>
            <p class="eyebrow">Junior Security Analyst</p>
            <p class="identity-note">
              Microsoft 365, security operations, SAL1 study, small tools
            </p>
          </div>
        </div>

        <h1>{name}</h1>

        <p class="hero-lede">
          I’m a Junior Security Analyst in the UK. I use this site to document
          what I’m learning, share notes, and publish small security tools I’ve
          built.
        </p>

        <p class="hero-support">
          Most of my day-to-day work sits around Microsoft 365 security,
          endpoint management, identity, email security, vulnerability
          remediation, and security operations. I’m also currently working
          towards TryHackMe Security Analyst Level 1 (SAL1).
        </p>

        <p class="hero-context">
          The site brings together research notes, safe work write-ups, and
          small tools I have built while learning and working in security.
        </p>

        <div class="hero-actions">
          <a href="/tools" class="primary-button">View Tools</a>
          <a href="/research" class="secondary-button">Read Research</a>
          <a href="/cv" class="secondary-button">View CV</a>
          <a
            href="https://github.com/0xW0lf"
            target="_blank"
            rel="noopener"
            class="secondary-button"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- WHAT I DO -->
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Snapshot</p>
          <h2>What I focus on</h2>
        </div>

        <p>
          These are the areas I’m currently working on and learning through my
          role, home lab, tools, and write-ups.
        </p>
      </div>

      <div class="focus-grid">
        {focusAreas.map((area) => (
          <article>
            <p class="eyebrow">{area.label}</p>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- FEATURED TOOLS -->
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Tools I’ve built</p>
          <h2>Featured tools</h2>
        </div>

        <a href="/tools" class="section-link">View all tools →</a>
      </div>

      <div class="tool-grid">
        {featuredTools.map((tool) => (
          <a href={tool.href} class="tool-card">
            <div class="card-top">
              <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
              <span class="status-pill">Available</span>
            </div>

            <p class="eyebrow">{tool.category}</p>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>

            <span class="card-link">Launch tool →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- LATEST POSTS -->
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research</p>
          <h2>Latest Research</h2>
        </div>

        <a href="/research" class="section-link">View all research →</a>
      </div>

      <div class="research-grid">
        {latestPosts.map((post) => (
          <a href={"/research/" + post.id} class="research-card">
            <div class="tag-row">
              {(post.data.tags ?? []).slice(0, 2).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>

            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>

            <time datetime={post.data.pubDate}>
              {new Date(post.data.pubDate).toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </time>
          </a>
        ))}
      </div>
    </section>

    <!-- LEARNING -->
    <section class="section-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Learning</p>
          <h2>Certifications and labs</h2>
        </div>

        <a href="/certifications" class="section-link">View certifications →</a>
      </div>

      <div class="learning-grid">
        <article>
          <p class="eyebrow">TryHackMe</p>
          <h3>Hands-on practice</h3>
          <p>
            I use TryHackMe to keep practising the fundamentals and to fill
            gaps as I move deeper into security work.
          </p>
          <a href="https://tryhackme.com/p/0xW0lf" target="_blank" rel="noopener">
            View TryHackMe profile →
          </a>
        </article>

        <article>
          <p class="eyebrow">Latest certification</p>
          <h3>Cyber Security 101 (SEC1)</h3>
          <p>
            Awarded August 2026. An entry-level certification validating core
            cyber security, networking, operating system, and security
            principle knowledge.
          </p>
          <a
            href="https://www.credly.com/badges/e3bbcd17-4240-450c-9c33-3b481562ad26/public_url"
            target="_blank"
            rel="noopener noreferrer"
          >
            View credential →
          </a>
        </article>

        <article class="learning-card-highlight">
          <p class="eyebrow">Currently studying</p>
          <h3>Security Analyst Level 1 (SAL1)</h3>
          <p>
            Working towards TryHackMe SAL1. This is not yet awarded; I’m using
            it to strengthen alert triage, threat detection, SOC simulation,
            and analyst report-writing skills.
          </p>
          <a
            href="https://tryhackme.com/certification/security-analyst-level-1"
            target="_blank"
            rel="noopener noreferrer"
          >
            View SAL1 certification →
          </a>
        </article>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section-shell about-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">About</p>
          <h2>About Me</h2>
        </div>
      </div>

      <div class="about-card">
        <p>
          Hi, I'm Elliot, a Junior Security Analyst based in the UK with a
          focus on security work, Microsoft 365, and automation. I like
          understanding how systems work, investigating security problems, and
          building small tools that make repeat tasks easier.
        </p>

        <p>
          My experience includes endpoint security, governance, Microsoft 365
          administration, phishing awareness, automation, and incident response.
          Outside of work, I use labs, write-ups, and side projects to keep
          improving.
        </p>

        <p>
          This site is where I keep that work in one place.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero {
    border-bottom: 1px solid #1f2937;
  }

  .hero-inner,
  .section-shell {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .hero-inner {
    padding: 5rem 0 4rem;
  }

  .identity-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .profile-image {
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 1rem;
    object-fit: cover;
  }

  .eyebrow {
    margin: 0;
    color: #a78bfa;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .identity-note {
    margin: 0.35rem 0 0;
    color: #64748b;
    font-size: 0.9rem;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hero-lede {
    max-width: 760px;
    margin: 1.5rem 0 0;
    color: #e2e8f0;
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    line-height: 1.55;
  }

  .hero-support {
    max-width: 760px;
    margin: 1rem 0 0;
    color: #94a3b8;
    line-height: 1.75;
  }

  .hero-context {
    max-width: 760px;
    margin: 0.85rem 0 0;
    color: #c4b5fd;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    padding: 0.85rem 1.1rem;
    border-radius: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-button {
    background: #6d28d9;
    color: white;
  }

  .secondary-button {
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #e2e8f0;
  }

  .primary-button:hover {
    background: #5b21b6;
  }

  .secondary-button:hover {
    border-color: rgba(167, 139, 250, 0.65);
    color: #ddd6fe;
  }

  .section-shell {
    padding: 4.5rem 0;
    border-bottom: 1px solid #1f2937;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    margin: 0.35rem 0 0;
    color: #f8fafc;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.1;
  }

  .section-heading > p {
    max-width: 520px;
    margin: 0;
    color: #94a3b8;
    line-height: 1.65;
  }

  .section-link,
  .learning-grid a {
    color: #ddd6fe;
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .section-link:hover,
  .learning-grid a:hover {
    color: #bfdbfe;
  }

  .focus-grid,
  .tool-grid,
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .learning-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .focus-grid article,
  .tool-card,
  .research-card,
  .learning-grid article,
  .about-card {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.55);
  }

  .focus-grid article,
  .tool-card,
  .research-card,
  .learning-grid article,
  .about-card {
    padding: 1.25rem;
  }

  .focus-grid h3,
  .tool-card h3,
  .research-card h3,
  .learning-grid h3 {
    margin: 0.75rem 0 0;
    color: #f8fafc;
    font-size: 1.1rem;
  }

  .focus-grid p:not(.eyebrow),
  .tool-card p:not(.eyebrow),
  .research-card p,
  .learning-grid p,
  .about-card p {
    margin: 0.85rem 0 0;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .tool-card,
  .research-card {
    display: flex;
    min-height: 245px;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .tool-card:hover,
  .research-card:hover {
    transform: translateY(-2px);
    border-color: rgba(167, 139, 250, 0.65);
    background: rgba(15, 23, 42, 0.75);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .tool-icon {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 0.75rem;
    background: rgba(167, 139, 250, 0.08);
    font-size: 1.3rem;
  }

  .status-pill {
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(134, 239, 172, 0.3);
    border-radius: 999px;
    color: #86efac;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .card-link {
    margin-top: auto;
    padding-top: 1.5rem;
    color: #ddd6fe;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .tag-row span {
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.08);
    color: #bfdbfe;
    font-size: 0.68rem;
  }

  .research-card time {
    margin-top: auto;
    padding-top: 1.5rem;
    color: #64748b;
    font-family: monospace;
    font-size: 0.72rem;
  }

  .learning-grid article {
    min-height: 190px;
  }

  .learning-card-highlight {
    border-color: rgba(251, 191, 36, 0.32);
    background:
      linear-gradient(145deg, rgba(251, 191, 36, 0.08), transparent 42%),
      rgba(15, 23, 42, 0.55);
  }

  .learning-grid a {
    display: inline-flex;
    margin-top: 1rem;
  }

  .about-section {
    border-bottom: 0;
  }

  .about-card {
    max-width: 820px;
  }

  @media (max-width: 900px) {
    .section-heading {
      display: grid;
      align-items: start;
    }

    .focus-grid,
    .tool-grid,
    .research-grid,
    .learning-grid {
      grid-template-columns: 1fr;
    }

    .section-shell {
      padding: 3.5rem 0;
    }
  }
</style>
