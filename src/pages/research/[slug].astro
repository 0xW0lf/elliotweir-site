---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("research");
  const sorted = posts.sort(
    (a, b) =>
      new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime(),
  );

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: sorted[index - 1] ?? null,
      next: sorted[index + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = new Date(post.data.pubDate).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="post-page">
    <a href="/research" class="back-link">← Back to research</a>

    <div class="post-layout">
      <article class="post-article">
        <header class="post-header">
          <p class="eyebrow">Research note</p>
          <h1>{post.data.title}</h1>

          <div class="meta">
            <span>{formattedDate}</span>
            <span>{readingTime} min read</span>
          </div>

          {(post.data.tags ?? []).length > 0 && (
            <div class="tags">
              {(post.data.tags ?? []).map((tag) => (
                <a href={"/research?tag=" + tag}>{tag}</a>
              ))}
            </div>
          )}

          <p>{post.data.description}</p>
        </header>

        <div class="content-card">
          <div class="prose prose-invert max-w-none" id="post-content">
            <Content />
          </div>
        </div>

        <nav class="post-nav" aria-label="Research navigation">
          <div>
            {prev && (
              <a href={"/research/" + prev.id}>
                <span>← Previous</span>
                <strong>{prev.data.title}</strong>
              </a>
            )}
          </div>

          <div>
            {next && (
              <a href={"/research/" + next.id}>
                <span>Next →</span>
                <strong>{next.data.title}</strong>
              </a>
            )}
          </div>
        </nav>
      </article>

      <aside class="toc-panel">
        <div class="toc-inner">
          <p class="eyebrow">On this page</p>
          <nav id="toc"></nav>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  const content = document.getElementById("post-content");
  const toc = document.getElementById("toc");

  if (content && toc) {
    const headings = content.querySelectorAll("h2, h3");

    headings.forEach((heading) => {
      const el = heading as HTMLElement;

      if (!el.id) {
        el.id = el.textContent
          ? el.textContent
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/(^-|-$)/g, "")
          : Math.random().toString(36).slice(2);
      }

      const link = document.createElement("a");
      link.href = "#" + el.id;
      link.textContent = el.textContent;
      link.dataset.id = el.id;
      link.className =
        el.tagName === "H3" ? "toc-link toc-link-nested" : "toc-link";

      toc.appendChild(link);
    });

    const tocLinks = toc.querySelectorAll(
      ".toc-link",
    ) as NodeListOf<HTMLElement>;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((link) => {
              link.classList.toggle("active", link.dataset.id === entry.target.id);
            });
          }
        });
      },
      { rootMargin: "0px 0px -70% 0px", threshold: 0 },
    );

    headings.forEach((heading) => observer.observe(heading));
  }
</script>

<style>
  .post-page {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3rem 0 6rem;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 2rem;
    color: #94a3b8;
    font-family: monospace;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: #ddd6fe;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 1.25rem;
    align-items: start;
  }

  .post-header,
  .content-card,
  .toc-inner,
  .post-nav a {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.55);
  }

  .post-header {
    padding: 1.5rem;
  }

  .eyebrow {
    margin: 0;
    color: #a78bfa;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-header h1 {
    margin: 0.75rem 0 0;
    color: #f8fafc;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .post-header > p:not(.eyebrow) {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #94a3b8;
    line-height: 1.75;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
    color: #64748b;
    font-family: monospace;
    font-size: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tags a {
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.08);
    color: #bfdbfe;
    font-size: 0.7rem;
    text-decoration: none;
  }

  .content-card {
    margin-top: 1rem;
    padding: 1.5rem;
  }

  .toc-panel {
    position: sticky;
    top: 1.5rem;
  }

  .toc-inner {
    padding: 1rem;
  }

  #toc {
    display: grid;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  #toc :global(.toc-link) {
    display: block;
    padding: 0.45rem 0.65rem;
    border-left: 2px solid transparent;
    color: #94a3b8;
    font-size: 0.82rem;
    line-height: 1.35;
    text-decoration: none;
  }

  #toc :global(.toc-link-nested) {
    padding-left: 1.25rem;
    color: #64748b;
    font-size: 0.76rem;
  }

  #toc :global(.toc-link.active) {
    border-color: #a78bfa;
    color: #ddd6fe;
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .post-nav a {
    display: flex;
    min-height: 110px;
    flex-direction: column;
    justify-content: center;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .post-nav div:last-child {
    text-align: right;
  }

  .post-nav span {
    color: #64748b;
    font-size: 0.75rem;
  }

  .post-nav strong {
    margin-top: 0.4rem;
    color: #e2e8f0;
    line-height: 1.35;
  }

  .post-nav a:hover strong {
    color: #ddd6fe;
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .toc-panel {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav div:last-child {
      text-align: left;
    }
  }
</style>
